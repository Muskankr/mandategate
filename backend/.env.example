# ─── MandateGate Backend Configuration ───────────────────────────

# Database (SQLite default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./mandategate.db

# Google Gemini AI (optional — fallback demo products used when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# PayPal Sandbox (optional — stub orders generated when empty)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Frontend URL for CORS and PayPal return URLs
FRONTEND_URL=http://localhost:3000
